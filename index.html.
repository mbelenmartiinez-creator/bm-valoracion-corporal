<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f7f6f2"><title>BM | Valoración corporal</title><style>:root{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#293b39;background:#f7f6f2}*{box-sizing:border-box}body{margin:0}main{max-width:700px;margin:auto;padding:20px 16px 70px}.top{display:flex;justify-content:space-between;align-items:center}.brand{font-family:Georgia,serif;font-size:27px;color:#456b62}.sub{color:#70837c;font-size:12px;letter-spacing:1.4px;text-transform:uppercase}h1{font-size:24px;margin:24px 0 5px}p{color:#667b73;line-height:1.5}.panel{background:#fff;border:1px solid #e5eae5;border-radius:20px;padding:18px;margin-top:16px;box-shadow:0 4px 15px #2c4e4010}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{margin:0 0 13px}.field label{display:block;font-size:12px;font-weight:700;margin-bottom:7px;color:#526b63}input,select{width:100%;padding:13px 10px;border:1px solid #d5dfd9;border-radius:11px;background:#fcfdfb;font-size:16px;color:#273b35}input:focus,select:focus{outline:2px solid #a9cbb9}.actions{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0}button{border:0;border-radius:12px;padding:13px 17px;font-weight:700;font-size:14px;background:#476d62;color:#fff;cursor:pointer}button.secondary{background:#e5eee8;color:#355b50}button.outline{background:#fff;border:1px solid #ccd9d0;color:#355b50}.hide{display:none!important}.resultHead{display:flex;justify-content:space-between;align-items:start;gap:10px}.small{font-size:12px;color:#7b8d84}.results{display:grid;grid-template-columns:1fr 110px 1fr;gap:8px;align-items:center;margin:18px 0}.metric{padding:11px 8px;background:#f6f8f5;border-radius:13px;margin-bottom:9px;min-height:95px}.metric .label{font-size:11px;color:#587066}.metric .value{font-size:22px;font-weight:700;margin:5px 0}.tag{display:inline-block;padding:4px 7px;border-radius:30px;font-size:11px;font-weight:700;background:#e7ebe9;color:#596761}.good{background:#dbece1;color:#32644e}.mid{background:#f7e9c8;color:#86611e}.high{background:#f1d9d2;color:#9a5447}.neutral{background:#e9edf0;color:#536575}.sil{width:100%;height:auto}.conclusion{background:#f2f6f1;border-radius:14px;padding:14px;font-size:14px;line-height:1.55}.note{font-size:11px;color:#7c8982;line-height:1.5;margin-top:14px}#patientView{display:none}body.showPatient #patientView{display:block}body.showPatient #editor{display:none}body.showPatient main{max-width:740px}body.showPatient .results{grid-template-columns:1fr 130px 1fr}@media print{body{background:#fff}main{padding:0}.actions,#editor,.no-print{display:none!important}#patientView{display:block!important}.panel{box-shadow:none;border:0}.metric{break-inside:avoid}}@media(max-width:360px){.results{grid-template-columns:1fr 85px 1fr}.metric .value{font-size:19px}.panel{padding:12px}}</style></head><body><main><div class="top"><div><div class="brand">BM <span style="font-family:sans-serif;font-size:14px;color:#9bb7aa">| HEPATOLOGÍA</span></div><div class="sub">Valoración de composición corporal</div></div><div style="font-size:30px;color:#b7d1c3">◌</div></div><section id="editor"><h1>Datos de la consulta</h1><p>Cargá las mediciones una sola vez. La interpretación se actualizará automáticamente.</p><div class="panel"><div class="field"><label for="nombre">Nombre y apellido (opcional)</label><input id="nombre" autocomplete="off" placeholder="Paciente de prueba"></div><div class="grid"><div class="field"><label for="fecha">Fecha</label><input id="fecha" type="date"></div><div class="field"><label for="edad">Edad (años)</label><input id="edad" type="number" min="18" max="100" placeholder="Ej. 45"></div><div class="field"><label for="sexo">Sexo para referencias Omron</label><select id="sexo"><option value="">Seleccionar</option><option value="mujer">Mujer</option><option value="hombre">Hombre</option></select></div><div class="field"><label for="peso">Peso (kg)</label><input id="peso" inputmode="decimal" placeholder="Ej. 78,5"></div><div class="field"><label for="talla">Talla (cm)</label><input id="talla" inputmode="decimal" placeholder="Ej. 165"></div><div class="field"><label for="cintura">Perímetro abdominal (cm)</label><input id="cintura" inputmode="decimal" placeholder="Ej. 94"></div><div class="field"><label for="visceral">Grasa visceral (nivel 1–30)</label><input id="visceral" inputmode="numeric" placeholder="Ej. 12"></div><div class="field"><label for="grasa">Grasa corporal total (%)</label><input id="grasa" inputmode="decimal" placeholder="Ej. 35"></div><div class="field"><label for="musculo">Músculo esquelético (%)</label><input id="musculo" inputmode="decimal" placeholder="Ej. 29"></div></div><div class="actions"><button id="show">Mostrar al paciente</button><button class="secondary" id="copy">Copiar evolución</button><button class="outline" id="clear">Nueva valoración</button></div><div id="status" class="small" aria-live="polite"></div></div></section><section id="patientView"><div class="actions no-print"><button class="secondary" id="back">← Volver a editar</button><button id="copy2">Copiar evolución</button><button class="outline" id="print">Guardar / imprimir PDF</button></div><div class="panel"><div class="resultHead"><div><div class="sub">Tu valoración actual</div><h1 id="patientName" style="margin:8px 0">Valoración corporal</h1><div class="small" id="patientDate"></div></div><div style="font-family:Georgia,serif;color:#638f7d;font-size:26px">BM</div></div><div class="results"><div><div class="metric"><div class="label">Peso</div><div class="value" id="rPeso">—</div><span class="tag neutral" id="rImc">IMC —</span></div><div class="metric"><div class="label">Grasa corporal total</div><div class="value" id="rGrasa">—</div><span class="tag" id="cGrasa">Sin datos</span></div><div class="metric"><div class="label">Grasa visceral · nivel Omron</div><div class="value" id="rVisceral">—</div><span class="tag" id="cVisceral">Sin datos</span></div></div><svg class="sil" viewBox="0 0 125 255" aria-label="Silueta ilustrativa del cuerpo humano"><circle cx="62.5" cy="29" r="20" fill="#bdd7ca"/><path d="M42 54 Q28 56 25 85 L15 134 Q13 144 22 147 Q31 149 34 137 L44 101 L45 152 L42 230 Q42 242 53 242 Q64 242 64 230 L65 168 L68 230 Q68 242 79 242 Q90 242 89 230 L86 152 L85 101 L95 137 Q98 149 107 147 Q116 144 113 134 L103 85 Q100 56 85 54Z" fill="#bdd7ca"/><ellipse cx="65" cy="119" rx="25" ry="31" fill="#e9b7a7" opacity=".9"/><path d="M41 114 Q64 127 90 114" fill="none" stroke="#ba7c6b" stroke-width="2" stroke-dasharray="4 3"/></svg><div><div class="metric"><div class="label">Perímetro abdominal</div><div class="value" id="rCintura">—</div><span class="tag neutral">Medición directa</span></div><div class="metric"><div class="label">Índice cintura/talla</div><div class="value" id="rRatio">—</div><span class="tag" id="cRatio">Sin datos</span></div><div class="metric"><div class="label">Músculo esquelético</div><div class="value" id="rMusculo">—</div><span class="tag" id="cMusculo">Sin datos</span></div></div></div><div class="conclusion"><strong>Conclusión de la valoración</strong><div id="conclusion" style="margin-top:7px">Ingresá las mediciones para ver el resultado.</div></div><div class="note">Interpretación orientativa: rangos del fabricante Omron para grasa total, grasa visceral y músculo esquelético; índice cintura/talla para adiposidad central. La bioimpedancia no diagnostica por sí sola sarcopenia, fibrosis hepática ni riesgo cardiometabólico individual. La edad biológica no se utiliza. Datos procesados localmente; no se almacenan historiales de pacientes.</div></div></section></main><script>const ids=['nombre','fecha','edad','sexo','peso','talla','cintura','visceral','grasa','musculo'];const el=id=>document.getElementById(id);el('fecha').value=new Date().toLocaleDateString('en-CA');const raw=id=>el(id).value.trim();const n=id=>raw(id)===''?NaN:Number(raw(id).replace(',','.'));const fmt=(x,d=1)=>Number.isFinite(x)?x.toLocaleString('es-AR',{minimumFractionDigits:d,maximumFractionDigits:d}):'—';function category(v,edges,names){if(!Number.isFinite(v))return 'Sin datos';for(let i=0;i<edges.length;i++)if(v<edges[i])return names[i];return names[edges.length]}function thresholds(){let a=n('edad'),s=raw('sexo');if(!s||!Number.isFinite(a)||a<18||a>80)return null;let i=a<40?0:a<60?1:2;return {g:(s==='mujer'?[[21,33,39],[23,34,40],[24,36,42]]:[[8,20,25],[11,22,28],[13,25,30]])[i],m:(s==='mujer'?[[24.3,30.4,35.4],[24.1,30.2,35.2],[23.9,30,35]]:[[33.3,39.4,44.1],[33.1,39.2,43.9],[32.9,39,43.7]])[i],gAvailable:a>=20&&a<=79}}function calc(){const t=thresholds(),g=n('grasa'),m=n('musculo'),v=n('visceral'),w=n('cintura'),h=n('talla'),p=n('peso');const ratio=w>0&&h>0?w/h:NaN,imc=p>0&&h>0?p/((h/100)**2):NaN;let gc=t&&t.gAvailable&&g>=0&&g<=100?category(g,t.g,['Bajo','Normal','Elevado','Muy elevado']):'No clasificable';let mc=t&&m>=0&&m<=100?category(m,t.m,['Bajo','Normal','Alto','Muy alto']):'No clasificable';let vc=Number.isInteger(v)&&v>=1&&v<=30?category(v,[10,15],['Normal','Alto','Muy alto']):'No clasificable';let rc=Number.isFinite(ratio)&&ratio>0?category(ratio,[.5,.6],['Menor a 0,50','Aumentado','Elevado']):'Sin datos';return {p,g,m,v,w,h,ratio,imc,gc,mc,vc,rc}}function badge(id,value){el(id).textContent=value;el(id).className='tag '+(['Normal','Menor a 0,50'].includes(value)?'good':['Elevado','Alto','Aumentado'].includes(value)?'mid':['Muy elevado','Muy alto'].includes(value)?'high':'neutral')}function conclusion(c){let notes=[];if(c.rc==='Aumentado'||c.rc==='Elevado')notes.push('índice cintura/talla compatible con adiposidad central aumentada');else if(c.rc==='Menor a 0,50')notes.push('índice cintura/talla por debajo de 0,50');if(c.vc==='Alto'||c.vc==='Muy alto')notes.push('nivel de grasa visceral elevado según Omron');if(c.gc==='Elevado'||c.gc==='Muy elevado')notes.push('porcentaje de grasa corporal elevado para sexo y edad según Omron');if(c.mc==='Bajo')notes.push('porcentaje de músculo esquelético bajo según referencia del equipo');if(!notes.length)return 'Valoración registrada. Interpretar los resultados en conjunto con el contexto clínico.';return 'Se observa '+notes.join('; ')+'. Estos indicadores orientan el seguimiento de la composición corporal y no sustituyen la evaluación clínica.'}function render(){let c=calc();el('patientName').textContent=raw('nombre')||'Valoración corporal';el('patientDate').textContent=raw('fecha')?raw('fecha').split('-').reverse().join('/'):'Sin fecha';el('rPeso').textContent=fmt(c.p)+' kg';el('rImc').textContent='IMC '+fmt(c.imc);el('rCintura').textContent=fmt(c.w)+' cm';el('rRatio').textContent=fmt(c.ratio,2);el('rGrasa').textContent=fmt(c.g)+' %';el('rMusculo').textContent=fmt(c.m)+' %';el('rVisceral').textContent=fmt(c.v,0);badge('cGrasa',c.gc);badge('cMusculo',c.mc);badge('cVisceral',c.vc);badge('cRatio',c.rc);el('conclusion').textContent=conclusion(c)}function evolution(){let c=calc();return `Valoración de composición corporal (${raw('fecha')||'sin fecha'}). ${raw('nombre')?'Paciente: '+raw('nombre')+'. ':''}Peso: ${fmt(c.p)} kg; IMC: ${fmt(c.imc)} kg/m²; perímetro abdominal: ${fmt(c.w)} cm; índice cintura/talla: ${fmt(c.ratio,2)} (${c.rc}); grasa visceral Omron: ${fmt(c.v,0)} (${c.vc}); grasa corporal: ${fmt(c.g)}% (${c.gc}); músculo esquelético: ${fmt(c.m)}% (${c.mc}). ${conclusion(c)} Interpretación orientativa según referencias del equipo.`}async function copy(){const txt=evolution();try{await navigator.clipboard.writeText(txt);el('status').textContent='Evolución copiada.';alert('Evolución copiada.')}catch(e){const ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();alert('Evolución preparada para copiar.')}}el('show').onclick=()=>{render();document.body.classList.add('showPatient');scrollTo(0,0)};el('back').onclick=()=>{document.body.classList.remove('showPatient');scrollTo(0,0)};el('copy').onclick=copy;el('copy2').onclick=copy;el('print').onclick=()=>window.print();el('clear').onclick=()=>{if(!confirm('¿Limpiar todos los datos para una nueva valoración?'))return;ids.forEach(id=>{if(id!=='fecha')el(id).value=''});el('fecha').value=new Date().toLocaleDateString('en-CA');el('status').textContent='Datos limpiados.'};ids.forEach(id=>el(id).addEventListener('input',render));render();</script></body></html>
